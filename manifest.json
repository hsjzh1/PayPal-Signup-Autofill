{
  "manifest_version": 3,
  "name": "PayPal Signup Autofill",
  "version": "1.0.0",
  "description": "Autofill PayPal checkout signup form with saved profile data.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.paypal.com/checkoutweb/signup*",
    "https://api.zippopotam.us/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PayPal Autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.paypal.com/checkoutweb/signup*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}